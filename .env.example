# Local development only. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase Auth token verification
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key; never expose in browser/mobile or commit to GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Responses API coordinator. Choose a model enabled for your API project.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Hermes Agent OpenAI-compatible API server (keep behind authenticated private ingress).
HERMES_BASE_URL=
HERMES_API_TOKEN=
HERMES_MODEL=hermes

# OpenClaw Gateway OpenAI-compatible API (keep private; do not expose device scopes by default).
OPENCLAW_BASE_URL=
OPENCLAW_API_TOKEN=
OPENCLAW_MODEL=openclaw/default

# OpenHands Agent Server. This runtime can execute code in its configured workspace.
# Keep disabled until isolated sandbox + approval-bound task dispatch are deployed.
OPENHANDS_BASE_URL=
OPENHANDS_API_TOKEN=
OPENHANDS_MODEL=
OPENHANDS_ENABLED=false

# Browser Use open-source Python SDK (read-only research adapter).
# Install with: pip install -e ".[agents]"
BROWSER_USE_API_KEY=
BROWSER_USE_MODEL=openai/gpt-5.5
BROWSER_USE_ENABLED=false
BROWSER_USE_TIMEOUT_SECONDS=120
