# Local development only. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Public project URL and publishable key. Used only to validate Supabase Auth tokens.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only privileged key. NEVER place this in a browser, mobile app, or GitHub.
# Required by the API for workspace and approval operations.
SUPABASE_SERVICE_ROLE_KEY=

# Hermes endpoint should remain private to the service network.
HERMES_BASE_URL=
HERMES_API_TOKEN=
