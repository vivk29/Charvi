# Local development only. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Coordinator model. Ollama is the default; no paid AI subscription is required.
COORDINATOR_PROVIDER=ollama
# For Docker API + Ollama installed on the host. Keep port 11434 firewalled/private.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=
OLLAMA_API_KEY=

# Durable LangGraph checkpoints. Use Supabase direct or session-pooler URI.
# Keep this server-only; never put it in browser/mobile variables or Git.
LANGGRAPH_POSTGRES_URI=
LANGGRAPH_STRICT_MSGPACK=true

# Optional paid API fallback. ChatGPT subscriptions do not include API credits.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Supabase Auth token verification
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key; never expose in browser/mobile or commit to GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# Hermes Agent OpenAI-compatible API server (keep behind authenticated private ingress).
HERMES_BASE_URL=
HERMES_API_TOKEN=
HERMES_MODEL=hermes

# OpenClaw Gateway OpenAI-compatible API (keep private; do not expose device scopes by default).
OPENCLAW_BASE_URL=
OPENCLAW_API_TOKEN=
OPENCLAW_MODEL=openclaw/default

# OpenHands Agent Server. Keep disabled until isolated sandbox + approval dispatch are deployed.
OPENHANDS_BASE_URL=
OPENHANDS_API_TOKEN=
OPENHANDS_MODEL=
OPENHANDS_ENABLED=false

# Browser Use isolated worker connection. The API receives no Browser Use provider key.
BROWSER_USE_WORKER_URL=http://browser-worker:8090
BROWSER_USE_WORKER_TOKEN=
BROWSER_USE_ENABLED=false
BROWSER_USE_TIMEOUT_SECONDS=150

# Optional private Kokoro-82M voice worker (enable with: docker compose --profile tts up -d)
# Set to http://voice-worker:7860 when using the Compose service.
KOKORO_TTS_URL=
KOKORO_TTS_TIMEOUT_SECONDS=60

# Optional private Whisper transcription worker (enable with: docker compose --profile transcription up -d --build)
WHISPER_WORKER_URL=http://whisper-worker:8095
WHISPER_WORKER_TOKEN=
WHISPER_WORKER_TIMEOUT_SECONDS=180
WHISPER_MODEL_SIZE=tiny
WHISPER_CPU_THREADS=2
