# Local development only. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Supabase Auth token verification
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key; never expose in browser/mobile or commit to GitHub.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI Responses API coordinator. Choose a model enabled for your API project.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Hermes Agent OpenAI-compatible API server
HERMES_BASE_URL=
HERMES_API_TOKEN=
HERMES_MODEL=hermes

# OpenClaw Gateway OpenAI-compatible API. Enable endpoint and keep it private.
OPENCLAW_BASE_URL=
OPENCLAW_API_TOKEN=
OPENCLAW_MODEL=openclaw/default

# Optional specialist services; URLs alone do not install or start these services.
OPENHANDS_BASE_URL=
OPENHANDS_API_TOKEN=
OPENHANDS_MODEL=
BROWSER_USE_BASE_URL=
BROWSER_USE_API_TOKEN=
