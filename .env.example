# Local development only. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Public project URL and publishable key. The API uses these to ask Supabase Auth
# to validate a user's bearer access token. These are not privileged secrets.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Hermes endpoint should remain private to the service network.
HERMES_BASE_URL=
HERMES_API_TOKEN=
