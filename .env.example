# Local development only. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Configure only in a local secret manager or untracked .env file.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Hermes endpoint should remain private to the service network.
HERMES_BASE_URL=
HERMES_API_TOKEN=
